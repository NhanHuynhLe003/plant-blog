{
  "name": "InkRecall – Ôn ghi chú viết tay",
  "short_name": "InkRecall",
  "description": "Ôn tập ghi chú viết tay từ Samsung Notes bằng lặp lại ngắt quãng.",
  "lang": "vi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f7f9",
  "theme_color": "#257de0",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["application/pdf", "image/*", ".pdf", ".png", ".jpg", ".jpeg", ".webp"] }]
    }
  },
  "shortcuts": [
    { "name": "Ôn tập ngay", "url": "./#/review" },
    { "name": "Nhập ghi chú", "url": "./#/notes" }
  ]
}
